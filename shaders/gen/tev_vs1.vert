  vec3 lit = scene.self.ambient.rgb;
  lit += scene.self.light_color0.rgb * max(dot(normal, -scene.self.light_dir0.xyz), 0.0);
  lit += scene.self.light_color1.rgb * max(dot(normal, -scene.self.light_dir1.xyz), 0.0);
  lit += scene.self.light_color2.rgb * max(dot(normal, -scene.self.light_dir2.xyz), 0.0);
  lit = min(max(lit, vec3(0.0)), vec3(1.0));

  v_color = vec4(lit, 1.0) * in_color * scene.self.material_color;
  v_texcoord0 = (scene.self.tex_matrix0 * vec4(in_texcoord0, 0.0, 1.0)).xy;

  gl_Position = scene.self.view_proj * world_position;
}
