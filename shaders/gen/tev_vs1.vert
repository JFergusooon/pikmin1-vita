  mat4 view_proj;
  mat4 world;
  mat4 tex_matrix0;
  mat4 tex_matrix1;
  mat4 tex_matrix2;
  mat4 tex_matrix3;
  vec4 light_dir0;
  vec4 light_dir1;
  vec4 light_dir2;
